# DalalSight configuration. Copy to `.env` (same folder) and fill in.
# `.env` is git-ignored and secrets stay on the backend: nothing below is ever sent to the browser.
# packages/tradingagents/.env is also loaded if it exists, but this single root file is enough.

# --- Server ---
CC_HOST=127.0.0.1
# Leave empty on hosts that set PORT themselves (Render, Railway, Fly.io, ...).
CC_PORT=8765
CC_DB_PATH=data/dalalsight.db
# true = also allow the Vite dev server (http://localhost:5173) to call the API. Use false on a server.
CC_DEV_MODE=true
# Token for every API call (X-Access-Token header) and the WebSocket; the dashboard asks for it once.
# Required whenever CC_HOST is not 127.0.0.1/localhost: the server refuses to start without it.
CC_ACCESS_TOKEN=
# Comma-separated dashboard origins allowed to call the API from another domain,
# e.g. https://your-dashboard.vercel.app
CC_CORS_ORIGINS=

# --- Supabase (cloud copy of all data and logs) ---
# The local database stays the source of truth; every change is also copied to Supabase (queued while offline).
# Project URL: Supabase dashboard -> Project Settings -> Data API, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Secret key (sb_secret_..., or the legacy service_role key). Server only: never put it in a VITE_* variable.
SUPABASE_SECRET_KEY=
# Seconds between copies.
SUPABASE_SYNC_SECONDS=15

# --- AI models (OpenAI-compatible endpoint; OpenRouter by default) ---
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
# Either put the key here, or name the variable that holds it (OPENROUTER_API_KEY below).
AI_API_KEY=
AI_API_KEY_ENV=OPENROUTER_API_KEY
# Used when the provider lists it and it is healthy; otherwise the fallback is used.
DEFAULT_AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
FALLBACK_AI_MODEL=nvidia/nemotron-3-super-120b-a12b:free
AI_TIMEOUT_SECONDS=120
# Hard cap on AI calls per IST day (free OpenRouter tiers are rate-limited).
AI_DAILY_CALL_BUDGET=45
# Seconds the default model is skipped after an overload/timeout.
AI_MODEL_COOLDOWN_SECONDS=600

# --- Market data ---
# public = NSE public site API + Yahoo Finance (no key; unofficial, no SLA).
# kite / upstox / dhan = broker feeds (interface present, requires the credentials below; not implemented yet).
MARKET_DATA_PROVIDER=public
OPTION_DATA_PROVIDER=nse
MARKET_DATA_API_KEY=
MARKET_DATA_API_SECRET=
MARKET_DATA_ACCESS_TOKEN=
OPTION_DATA_API_KEY=

# --- Charts ---
# Show the "Open in TradingView" links (embedded TradingView widgets cannot show NSE/BSE data).
TRADINGVIEW_WIDGET_ENABLED=true
# Optional licensed TradingView Advanced Charts library folder (not bundled; requires a TradingView licence).
TRADINGVIEW_CHARTING_LIBRARY_PATH=

# --- Execution ---
# analysis | paper. LIVE execution is disabled and additionally needs LIVE_EXECUTION_ENABLED=true and a broker.
EXECUTION_MODE=analysis
LIVE_EXECUTION_ENABLED=false

# --- Optional alert channels ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# --- TradingAgents India (packages/tradingagents) ---
# Provider key shared by DalalSight (AI_API_KEY_ENV above) and TradingAgents.
OPENROUTER_API_KEY=
TRADINGAGENTS_MARKET=india
TRADINGAGENTS_LLM_PROVIDER=openrouter
TRADINGAGENTS_QUICK_THINK_LLM=nvidia/nemotron-3-super-120b-a12b:free
TRADINGAGENTS_DEEP_THINK_LLM=nvidia/nemotron-3-ultra-550b-a55b:free
# Folder whose .env is also loaded (default: packages/tradingagents).
TRADINGAGENTS_DIR=
