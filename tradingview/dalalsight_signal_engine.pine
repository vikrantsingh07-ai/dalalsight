//@version=6
// DalalSight Signal Engine
// DalalSight's rule-based signal model, running on TradingView's own data.
// Each component scores -1..+1 with a configurable weight. Composite S = sum(w*s) / sum(w) over the
// components that have data; bullish scenario = 50 + 50*S; model confidence = agreeing weight /
// available weight * data coverage. Weak evidence gives "NO TRADE / WAIT FOR CONFIRMATION".
// Set alerts to "Once Per Bar Close" so they use completed bars. Research tool, not investment advice.
indicator("DalalSight Signal Engine", shorttitle = "DalalSight", overlay = true, max_labels_count = 200, max_lines_count = 50)

// ---------------------------------------------------------------- inputs
G_W = "Signal weights"
wTrend = input.float(20, "Trend", minval = 0, group = G_W)
wMom = input.float(15, "Momentum", minval = 0, group = G_W)
wVol = input.float(15, "Volume", minval = 0, group = G_W)
wEma = input.float(15, "EMA structure", minval = 0, group = G_W)
wVwap = input.float(10, "VWAP", minval = 0, group = G_W)
wStruct = input.float(15, "Market structure", minval = 0, group = G_W)
wVola = input.float(5, "Volatility", minval = 0, group = G_W)
wOpt = input.float(5, "Options (no option data in Pine: counts as unavailable)", minval = 0, group = G_W)

G_T = "Thresholds"
bullTh = input.float(65, "Bullish threshold %", minval = 50, maxval = 100, group = G_T)
bearTh = input.float(35, "Bearish threshold %", minval = 0, maxval = 50, group = G_T)
watchBand = input.float(8, "WATCH band (points from 50)", minval = 0, group = G_T)
minConf = input.float(55, "Minimum model confidence %", minval = 0, maxval = 100, group = G_T)
minCov = input.float(0.6, "Minimum data coverage (0-1)", minval = 0, maxval = 1, step = 0.05, group = G_T)
minRR = input.float(1.5, "Minimum risk:reward", minval = 0.1, step = 0.1, group = G_T)
maxStopAtr = input.float(3.0, "Maximum stop distance (ATR)", minval = 0.1, step = 0.1, group = G_T)

G_I = "Indicators"
emaFastLen = input.int(9, "EMA fast", minval = 2, group = G_I)
emaSlowLen = input.int(21, "EMA slow", minval = 3, group = G_I)
confirmBars = input.int(2, "Crossover confirmation bars", minval = 1, maxval = 10, group = G_I)
rsiLen = input.int(14, "RSI length", minval = 2, group = G_I)
rsiOB = input.float(70, "RSI overbought", group = G_I)
rsiOS = input.float(30, "RSI oversold", group = G_I)
atrLen = input.int(14, "ATR length", minval = 2, group = G_I)
stLen = input.int(10, "Supertrend ATR length", minval = 2, group = G_I)
stMult = input.float(3.0, "Supertrend multiplier", minval = 0.5, step = 0.1, group = G_I)
swingLb = input.int(3, "Swing lookback", minval = 1, maxval = 20, group = G_I)
breakoutLb = input.int(20, "Breakout lookback", minval = 5, group = G_I)
volSpike = input.float(2.0, "Volume spike multiple", minval = 1, group = G_I)
volConfirm = input.float(1.5, "Volume confirmation multiple", minval = 1, group = G_I)

G_D = "Display"
showEma = input.bool(true, "EMA fast / slow", group = G_D)
showVwap = input.bool(true, "VWAP", group = G_D)
showSt = input.bool(false, "Supertrend", group = G_D)
showLevels = input.bool(true, "Support / resistance", group = G_D)
showPlan = input.bool(true, "Trade plan lines", group = G_D)
showLabels = input.bool(true, "Setup labels", group = G_D)
showTable = input.bool(true, "Signal panel", group = G_D)
panelPos = input.string("Top right", "Panel position", options = ["Top right", "Bottom right", "Top left", "Bottom left"], group = G_D)

// ---------------------------------------------------------------- helpers
clip(float x) =>
    math.max(-1.0, math.min(1.0, x))

nearAbove(array<float> lvls, float ref) =>
    float best = na
    for v in lvls
        if not na(v) and v > ref and (na(best) or v < best)
            best := v
    best

nearBelow(array<float> lvls, float ref) =>
    float best = na
    for v in lvls
        if not na(v) and v < ref and (na(best) or v > best)
            best := v
    best

agreeWeight(bool avail, float w, float s, int dir) =>
    avail and dir != 0 and math.sign(s) == dir and math.abs(s) >= 0.15 ? w : 0.0

fmtScore(bool avail, float s) =>
    avail ? str.tostring(s, "#.##") : "n/a"

fmtPrice(float p) =>
    na(p) ? "-" : str.tostring(p, format.mintick)

// ---------------------------------------------------------------- indicators
emaFast = ta.ema(close, emaFastLen)
emaSlow = ta.ema(close, emaSlowLen)
ema20 = ta.ema(close, 20)
ema50 = ta.ema(close, 50)
sma50 = ta.sma(close, 50)
sma200 = ta.sma(close, 200)
rsiVal = ta.rsi(close, rsiLen)
[macdLine, macdSignal, macdHist] = ta.macd(close, 12, 26, 9)
atrVal = ta.atr(atrLen)
atrSma = ta.sma(atrVal, 20)
[stLine, stDir] = ta.supertrend(stMult, stLen)
[diPlus, diMinus, adxVal] = ta.dmi(14, 14)
rawVwap = ta.vwap(hlc3)
volAvg = ta.sma(nz(volume), 20)
hasVolume = volAvg > 0
float vwapVal = timeframe.isintraday and hasVolume ? rawVwap : na

// ---------------------------------------------------------------- market regime
slope20 = ema20[5] != 0 ? (ema20 - ema20[5]) / ema20[5] * 100 : 0.0
int dirTrend = close > ema20 and ema20 > ema50 and slope20 > 0 ? 1 : close < ema20 and ema20 < ema50 and slope20 < 0 ? -1 : 0
atrPct = atrVal / close * 100
atrRank = ta.percentrank(atrPct, 100)
volRegime = atrRank >= 85 ? "high" : atrRank <= 15 ? "low" : "normal"
priorHigh = ta.highest(high, breakoutLb)[1]
priorLow = ta.lowest(low, breakoutLb)[1]
float atrRatio = atrSma > 0 ? atrVal / atrSma : na
int breakoutDir = close > priorHigh ? 1 : close < priorLow ? -1 : 0
crossedRecently = ta.barssince(ta.cross(emaFast, emaSlow)) <= 5

string regime = "Transition"
int regimeDir = dirTrend
if bar_index < 60 or na(ema50)
    regime := "Insufficient data"
else if breakoutDir != 0 and atrRatio >= 1.1
    regime := "Breakout"
    regimeDir := breakoutDir
else if dirTrend != 0 and adxVal >= 25
    regime := dirTrend > 0 ? "Strong bullish trend" : "Strong bearish trend"
else if dirTrend != 0 and adxVal >= 18
    regime := dirTrend > 0 ? "Weak bullish trend" : "Weak bearish trend"
else if volRegime == "high" and dirTrend == 0
    regime := "High volatility"
else if volRegime == "low" and adxVal < 18
    regime := "Low volatility"
else if adxVal < 20 and not crossedRecently
    regime := "Range-bound"

// ---------------------------------------------------------------- components
// Trend
trendAvail = regime != "Insufficient data"
float trendBase = switch regime
    "Strong bullish trend" => 1.0
    "Weak bullish trend" => 0.6
    "Strong bearish trend" => -1.0
    "Weak bearish trend" => -0.6
    "Range-bound" => 0.0
    "Breakout" => 0.8 * regimeDir
    => close > ema50 ? 0.2 : -0.2
trendScore = clip(trendBase + (na(sma200) ? 0.0 : close > sma200 ? 0.2 : -0.2))

// Momentum
momAvail = not na(rsiVal) and not na(macdHist[3])
histExpanding = math.abs(macdHist) > math.abs(macdHist[1])
rsiChange = rsiVal - rsiVal[3]
momScore = clip(clip((rsiVal - 50) / 20) * 0.5 + math.sign(macdHist) * (histExpanding ? 0.3 : 0.15) + (math.abs(rsiChange) > 3 ? 0.2 * math.sign(rsiChange) : 0.0))

// Volume (spot indices carry no volume: use a futures chart such as NSE:NIFTY1! for this component)
float volRatio = volAvg[1] > 0 ? nz(volume) / volAvg[1] : na
volAvail = hasVolume and not na(volRatio)
signedSum = math.sum(nz(volume) * math.sign(close - open), 10)
volSum = math.sum(nz(volume), 10)
signedBal = volSum > 0 ? signedSum / volSum : 0.0
barDir = close >= open ? 1.0 : -1.0
volScore = clip((volRatio >= volConfirm ? barDir * math.min(1.0, 0.4 + (volRatio - 1) / 1.5) : 0.0) + 0.3 * signedBal)
volumeSpike = volAvail and volRatio >= volSpike

// EMA structure: a crossover is confirmed when every one of the last N bars closed on the new side
diff = emaFast - emaSlow
bool allPos = true
bool allNeg = true
for i = 0 to confirmBars - 1
    allPos := allPos and diff[i] > 0
    allNeg := allNeg and diff[i] < 0
bullConfirm = diff[confirmBars] <= 0 and allPos and close > math.max(emaFast, emaSlow)
bearConfirm = diff[confirmBars] >= 0 and allNeg and close < math.min(emaFast, emaSlow)
crossUp = ta.crossover(emaFast, emaSlow)
crossDown = ta.crossunder(emaFast, emaSlow)
emaAvail = not na(emaSlow)
emaSlopePct = emaFast[3] != 0 ? (emaFast - emaFast[3]) / emaFast[3] * 100 : 0.0
stretch = atrVal > 0 ? (close - emaSlow) / atrVal : 0.0
emaScore = clip((emaFast > emaSlow ? 0.5 : -0.5) + (bullConfirm ? 0.3 : bearConfirm ? -0.3 : crossUp ? 0.15 : crossDown ? -0.15 : 0.0) + (math.abs(emaSlopePct) > 0.01 ? 0.2 * math.sign(emaSlopePct) : 0.0) - (math.abs(stretch) > 2.5 ? 0.3 * math.sign(stretch) : 0.0))

// VWAP
vwapAvail = not na(vwapVal)
vwapBreak = vwapAvail and close[1] < vwapVal[1] and close > vwapVal + 0.05 * atrVal
vwapLoss = vwapAvail and close[1] > vwapVal[1] and close < vwapVal - 0.05 * atrVal
vwapScore = clip((close > vwapVal ? 0.6 : -0.6) + (vwapBreak ? 0.4 : vwapLoss ? -0.4 : 0.0))

// Market structure: confirmed swings (pivots need swingLb bars on each side, so no look-ahead)
ph = ta.pivothigh(high, swingLb, swingLb)
pl = ta.pivotlow(low, swingLb, swingLb)
var float h1 = na
var float h2 = na
var float l1 = na
var float l2 = na
if not na(ph)
    h1 := h2
    h2 := ph
if not na(pl)
    l1 := l2
    l2 := pl
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1], lookahead = barmerge.lookahead_on)
pdc = request.security(syminfo.tickerid, "D", close[1], lookahead = barmerge.lookahead_on)
lvls = array.from(pdh, pdl, pdc, h1, h2, l1, l2, emaSlow, sma50, sma200, vwapVal)
nearestRes = nearAbove(lvls, close + 0.02 * atrVal)
nearestSup = nearBelow(lvls, close - 0.02 * atrVal)
breakout = close > priorHigh and close[1] <= priorHigh
breakdown = close < priorLow and close[1] >= priorLow
priorHigh2 = ta.highest(high, breakoutLb)[2]
priorLow2 = ta.lowest(low, breakoutLb)[2]
falseBreakout = close[1] > priorHigh2 and close < priorHigh2
falseBreakdown = close[1] < priorLow2 and close > priorLow2
structAvail = not na(h1) and not na(l1)
structBase = h2 > h1 and l2 > l1 ? 0.7 : h2 < h1 and l2 < l1 ? -0.7 : 0.0
structScore = clip(structBase + (breakout ? 0.3 : breakdown ? -0.3 : 0.0) + (falseBreakout ? -0.4 : falseBreakdown ? 0.4 : 0.0) + (not na(nearestRes) and nearestRes - close < 0.5 * atrVal ? -0.2 : 0.0) + (not na(nearestSup) and close - nearestSup < 0.5 * atrVal ? 0.2 : 0.0))

// Volatility
volaAvail = not na(atrRatio)
volaScore = volaAvail and atrRatio > 1.2 ? 0.5 * math.sign(close - close[3]) : 0.0

// ---------------------------------------------------------------- composite
totalW = wTrend + wMom + wVol + wEma + wVwap + wStruct + wVola + wOpt
availW = (trendAvail ? wTrend : 0.0) + (momAvail ? wMom : 0.0) + (volAvail ? wVol : 0.0) + (emaAvail ? wEma : 0.0) + (vwapAvail ? wVwap : 0.0) + (structAvail ? wStruct : 0.0) + (volaAvail ? wVola : 0.0)
weighted = (trendAvail ? wTrend * trendScore : 0.0) + (momAvail ? wMom * momScore : 0.0) + (volAvail ? wVol * volScore : 0.0) + (emaAvail ? wEma * emaScore : 0.0) + (vwapAvail ? wVwap * vwapScore : 0.0) + (structAvail ? wStruct * structScore : 0.0) + (volaAvail ? wVola * volaScore : 0.0)
composite = availW > 0 ? weighted / availW : 0.0
int direction = math.abs(composite) >= 0.05 ? (composite > 0 ? 1 : -1) : 0
agreeW = agreeWeight(trendAvail, wTrend, trendScore, direction) + agreeWeight(momAvail, wMom, momScore, direction) + agreeWeight(volAvail, wVol, volScore, direction) + agreeWeight(emaAvail, wEma, emaScore, direction) + agreeWeight(vwapAvail, wVwap, vwapScore, direction) + agreeWeight(structAvail, wStruct, structScore, direction) + agreeWeight(volaAvail, wVola, volaScore, direction)
coverage = totalW > 0 ? availW / totalW : 0.0
agreement = availW > 0 ? agreeW / availW : 0.0
bullPct = 50 + 50 * composite
confidence = 100 * agreement * coverage

// ---------------------------------------------------------------- trade plan (ATR + detected levels)
float entryLow = na
float entryHigh = na
float stopP = na
float t1 = na
float t2 = na
float rr = na
buffer = 0.2 * atrVal
if direction > 0 and atrVal > 0
    entryLow := close - 0.3 * atrVal
    entryHigh := close
    midL = (entryLow + entryHigh) / 2
    float stopL = nearBelow(array.from(l2 - buffer, emaSlow - buffer, vwapVal - buffer, nearestSup - buffer), entryLow - 0.5 * atrVal + syminfo.mintick)
    if na(stopL) or midL - stopL > maxStopAtr * atrVal
        stopL := entryLow - atrVal
    riskL = midL - stopL
    float tgt1 = nearAbove(lvls, entryHigh)
    if na(tgt1)
        tgt1 := midL + 2 * riskL
    float tgt2 = nearAbove(lvls, tgt1)
    if na(tgt2)
        tgt2 := tgt1 + riskL
    stopP := stopL
    t1 := tgt1
    t2 := tgt2
    rr := riskL > 0 ? (tgt1 - midL) / riskL : na
else if direction < 0 and atrVal > 0
    entryLow := close
    entryHigh := close + 0.3 * atrVal
    midS = (entryLow + entryHigh) / 2
    float stopS = nearAbove(array.from(h2 + buffer, emaSlow + buffer, vwapVal + buffer, nearestRes + buffer), entryHigh + 0.5 * atrVal - syminfo.mintick)
    if na(stopS) or stopS - midS > maxStopAtr * atrVal
        stopS := entryHigh + atrVal
    riskS = stopS - midS
    float tgt1 = nearBelow(lvls, entryLow)
    if na(tgt1)
        tgt1 := midS - 2 * riskS
    float tgt2 = nearBelow(lvls, tgt1)
    if na(tgt2)
        tgt2 := tgt1 - riskS
    stopP := stopS
    t1 := tgt1
    t2 := tgt2
    rr := riskS > 0 ? (midS - tgt1) / riskS : na

// ---------------------------------------------------------------- label
setupCandidate = direction != 0 and confidence >= minConf and (bullPct >= bullTh or bullPct <= bearTh)
opposingClose = direction > 0 ? (not na(nearestRes) and nearestRes - close < 0.5 * atrVal) : direction < 0 ? (not na(nearestSup) and close - nearestSup < 0.5 * atrVal) : false
string sigLabel = "NO TRADE / WAIT FOR CONFIRMATION"
if coverage >= minCov
    if setupCandidate and not na(stopP)
        sigLabel := direction > 0 ? "BULLISH SETUP" : "BEARISH SETUP"
        if rr < minRR
            sigLabel := "LOW-QUALITY SETUP"
        else if regime == "High volatility" or falseBreakout or falseBreakdown or opposingClose
            sigLabel := "HIGH-RISK SETUP"
    else if not setupCandidate and math.abs(bullPct - 50) >= watchBand
        sigLabel := "WATCH"
isSetup = sigLabel == "BULLISH SETUP" or sigLabel == "BEARISH SETUP" or sigLabel == "HIGH-RISK SETUP" or sigLabel == "LOW-QUALITY SETUP"
color labelColor = sigLabel == "BULLISH SETUP" ? #26a86f : sigLabel == "BEARISH SETUP" ? #e5534b : sigLabel == "WATCH" ? #5b93ff : isSetup ? #d6a13a : #8894a5

// ---------------------------------------------------------------- drawing
plot(showEma ? emaFast : na, "EMA fast", color = #5b93ff, linewidth = 2)
plot(showEma ? emaSlow : na, "EMA slow", color = #e0952b, linewidth = 2)
plot(showVwap ? vwapVal : na, "VWAP", color = #b284ff, linewidth = 2, style = plot.style_linebr)
plot(showSt ? stLine : na, "Supertrend", color = stDir < 0 ? #26a86f : #e5534b, style = plot.style_linebr)
plot(showLevels ? nearestRes : na, "Nearest resistance", color = color.new(#e5534b, 25), style = plot.style_circles)
plot(showLevels ? nearestSup : na, "Nearest support", color = color.new(#26a86f, 25), style = plot.style_circles)
plot(showLevels and timeframe.isintraday ? pdh : na, "Previous day high", color = color.new(#e5534b, 55), style = plot.style_stepline)
plot(showLevels and timeframe.isintraday ? pdl : na, "Previous day low", color = color.new(#26a86f, 55), style = plot.style_stepline)
plot(showLevels and timeframe.isintraday ? pdc : na, "Previous close", color = color.new(#8894a5, 40), style = plot.style_stepline)

if showLabels and isSetup and sigLabel != sigLabel[1] and barstate.isconfirmed
    label.new(bar_index, direction > 0 ? low : high, sigLabel + "\n" + str.tostring(bullPct, "#.#") + "% bullish | conf " + str.tostring(confidence, "#") + "%", style = direction > 0 ? label.style_label_up : label.style_label_down, color = labelColor, textcolor = color.white, size = size.small)

var line lnEntryHi = na
var line lnEntryLo = na
var line lnStop = na
var line lnT1 = na
var line lnT2 = na
var label lbPlan = na
if barstate.islast
    line.delete(lnEntryHi)
    line.delete(lnEntryLo)
    line.delete(lnStop)
    line.delete(lnT1)
    line.delete(lnT2)
    label.delete(lbPlan)
    if showPlan and isSetup
        x1 = bar_index - 15
        x2 = bar_index + 12
        lnEntryHi := line.new(x1, entryHigh, x2, entryHigh, color = #e0952b)
        lnEntryLo := line.new(x1, entryLow, x2, entryLow, color = #e0952b)
        lnStop := line.new(x1, stopP, x2, stopP, color = #e5534b, width = 2)
        lnT1 := line.new(x1, t1, x2, t1, color = #26a86f, width = 2, style = line.style_dashed)
        lnT2 := line.new(x1, t2, x2, t2, color = #26a86f, style = line.style_dashed)
        lbPlan := label.new(x2, t1, "Entry " + fmtPrice(entryLow) + " - " + fmtPrice(entryHigh) + "\nStop " + fmtPrice(stopP) + "\nT1 " + fmtPrice(t1) + "  T2 " + fmtPrice(t2) + "\nR:R 1:" + str.tostring(rr, "#.##"), style = label.style_label_left, color = color.new(#11161e, 10), textcolor = #e3e8ef, size = size.small)

setRow(table t, int r, string k, string v, color c) =>
    table.cell(t, 0, r, k, text_color = #8894a5, text_size = size.small, text_halign = text.align_left)
    table.cell(t, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)

tablePos = panelPos == "Top right" ? position.top_right : panelPos == "Bottom right" ? position.bottom_right : panelPos == "Top left" ? position.top_left : position.bottom_left
var table panel = table.new(tablePos, 2, 18, bgcolor = color.new(#0b0e13, 5), border_color = #243042, border_width = 1)
if showTable and barstate.islast
    setRow(panel, 0, "CC Signal Engine", sigLabel, labelColor)
    setRow(panel, 1, "Bullish / bearish", str.tostring(bullPct, "#.#") + "% / " + str.tostring(100 - bullPct, "#.#") + "%", #e3e8ef)
    setRow(panel, 2, "Model confidence", str.tostring(confidence, "#.#") + "%", #e3e8ef)
    setRow(panel, 3, "Data coverage", str.tostring(coverage * 100, "#") + "%", #e3e8ef)
    setRow(panel, 4, "Regime", regime, regimeDir > 0 ? #26a86f : regimeDir < 0 ? #e5534b : #5b93ff)
    setRow(panel, 5, "Trend (" + str.tostring(wTrend) + ")", fmtScore(trendAvail, trendScore), #e3e8ef)
    setRow(panel, 6, "Momentum (" + str.tostring(wMom) + ")", fmtScore(momAvail, momScore), #e3e8ef)
    setRow(panel, 7, "Volume (" + str.tostring(wVol) + ")", volAvail ? str.tostring(volScore, "#.##") : "n/a: no volume on this symbol", #e3e8ef)
    setRow(panel, 8, "EMA " + str.tostring(emaFastLen) + "/" + str.tostring(emaSlowLen) + " (" + str.tostring(wEma) + ")", fmtScore(emaAvail, emaScore), #e3e8ef)
    setRow(panel, 9, "VWAP (" + str.tostring(wVwap) + ")", vwapAvail ? str.tostring(vwapScore, "#.##") : "n/a: needs intraday volume", #e3e8ef)
    setRow(panel, 10, "Structure (" + str.tostring(wStruct) + ")", fmtScore(structAvail, structScore), #e3e8ef)
    setRow(panel, 11, "Volatility (" + str.tostring(wVola) + ")", fmtScore(volaAvail, volaScore), #e3e8ef)
    setRow(panel, 12, "Options (" + str.tostring(wOpt) + ")", "n/a in Pine", #8894a5)
    setRow(panel, 13, "RSI", str.tostring(rsiVal, "#.#") + (rsiVal >= rsiOB ? " overbought" : rsiVal <= rsiOS ? " oversold" : ""), #e3e8ef)
    setRow(panel, 14, "Support / resistance", fmtPrice(nearestSup) + " / " + fmtPrice(nearestRes), #e3e8ef)
    setRow(panel, 15, "Plan", isSetup ? "Entry " + fmtPrice(entryLow) + "-" + fmtPrice(entryHigh) + "  SL " + fmtPrice(stopP) : "none: wait for confirmation", isSetup ? #e0952b : #8894a5)
    setRow(panel, 16, "Targets / R:R", isSetup ? fmtPrice(t1) + " / " + fmtPrice(t2) + "  1:" + str.tostring(rr, "#.##") : "-", #e3e8ef)
    setRow(panel, 17, "Note", "Model estimate, not advice", #8894a5)

// ---------------------------------------------------------------- alerts (use "Once Per Bar Close")
alertcondition(sigLabel == "BULLISH SETUP" and sigLabel[1] != "BULLISH SETUP", "DalalSight: Bullish setup", "{{ticker}} {{interval}}: BULLISH SETUP at {{close}}")
alertcondition(sigLabel == "BEARISH SETUP" and sigLabel[1] != "BEARISH SETUP", "DalalSight: Bearish setup", "{{ticker}} {{interval}}: BEARISH SETUP at {{close}}")
alertcondition(bullConfirm, "DalalSight: EMA bullish crossover confirmed", "{{ticker}} {{interval}}: bullish EMA crossover confirmed at {{close}}")
alertcondition(bearConfirm, "DalalSight: EMA bearish crossover confirmed", "{{ticker}} {{interval}}: bearish EMA crossover confirmed at {{close}}")
alertcondition(breakout, "DalalSight: Breakout", "{{ticker}} {{interval}}: breakout above the prior range high at {{close}}")
alertcondition(breakdown, "DalalSight: Breakdown", "{{ticker}} {{interval}}: breakdown below the prior range low at {{close}}")
alertcondition(falseBreakout or falseBreakdown, "DalalSight: False breakout or breakdown", "{{ticker}} {{interval}}: possible false breakout at {{close}}")
alertcondition(volumeSpike, "DalalSight: Volume spike", "{{ticker}} {{interval}}: volume spike at {{close}}")
alertcondition(not na(nearestSup) and math.abs(low - nearestSup) <= 0.15 * atrVal, "DalalSight: Support test", "{{ticker}} {{interval}}: testing support near {{close}}")
alertcondition(not na(nearestRes) and math.abs(high - nearestRes) <= 0.15 * atrVal, "DalalSight: Resistance test", "{{ticker}} {{interval}}: testing resistance near {{close}}")
